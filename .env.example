# Auth database (tz-transport / time-zone)
# Supabase: use transaction pooler port 6543 (not session 5432) for pg — npm run sync:env does this.
TZ_TRANSPORT_DATABASE_URL=postgresql://user:pass@aws-0-region.pooler.supabase.com:6543/postgres

# Take & Bring (from Take-Bring/.env — uses Supabase client + optional pg)
TAKE_BRING_DATABASE_URL=postgresql://user:pass@aws-0-region.pooler.supabase.com:6543/postgres
TAKE_BRING_SUPABASE_URL=https://your-project.supabase.co
TAKE_BRING_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# TZ Reifenservice (main site)
TZ_REIFENSERVICE_DATABASE_URL=postgresql://user:pass@aws-0-region.pooler.supabase.com:6543/postgres

# TZ Reifenservice marketing / landing pages (offers.timezone-reifenservice.de)
TZ_REIFENSERVICE_OFFERS_DATABASE_URL=postgresql://user:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
TZ_REIFENSERVICE_OFFERS_SUPABASE_URL=https://your-project.supabase.co
TZ_REIFENSERVICE_OFFERS_SITE_URL=https://offers.timezone-reifenservice.de

# Vercel / serverless: keep pools small (default 1–2 for Supabase transaction pooler)
PG_POOL_MAX=1

# JWT secrets (generate strong random strings)
AUTH_JWT_SECRET=change-me-access-secret
AUTH_REFRESH_SECRET=change-me-refresh-secret

# Sync from sibling projects:
# npm run sync:env
